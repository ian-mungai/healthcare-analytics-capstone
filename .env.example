# Copy to .env and fill in locally. Never commit .env.

# Host user ID so files written by the containers are owned by you (run: id -u)
AIRFLOW_UID=50000

# Encrypts Airflow connections and variables in the metadata database.
# Generate: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=

# Extra Python packages installed in the Airflow containers at startup (local development only)
_PIP_ADDITIONAL_REQUIREMENTS="jupyter nbconvert ipykernel pandas numpy scipy statsmodels scikit-learn seaborn matplotlib boto3 awswrangler s3fs"

# Required by the DAG and notebook; use private local values, never commit .env.
S3_BUCKET=
AWS_REGION=
